#include "main.h"
#include <stm32f0xx_hal.h>

// This is a demo of a stepper motor control module I used made for the STM32


// Adjust this value in microseconds to tune speed:
// 3000 = 3.0 ms/step (~3.0s per 90 deg - slow, high torque)
// 1500 = 1.5 ms/step (~1.5s per 90 deg - medium-fast)
// 1000 = 1.0 ms/step (~1.0s per 90 deg - fast)
//  800 = 0.8 ms/step (~0.8s per 90 deg - near top speed)
#define STEP_DELAY_US 3000

// 4096 half-steps per full 360 revolution / 4 = 1024 steps per 90 degrees
#define STEPS_PER_90  1024

void SystemClock_Config(void);
void Error_Handler(void);

// 8-step half-step sequence for smooth rotation and maximum torque
const uint8_t step_sequence[8][4] = {
    {1, 0, 0, 0}, // Step 0: IN1
    {1, 1, 0, 0}, // Step 1: IN1 + IN2
    {0, 1, 0, 0}, // Step 2: IN2
    {0, 1, 1, 0}, // Step 3: IN2 + IN3
    {0, 0, 1, 0}, // Step 4: IN3
    {0, 0, 1, 1}, // Step 5: IN3 + IN4
    {0, 0, 0, 1}, // Step 6: IN4
    {1, 0, 0, 1}  // Step 7: IN4 + IN1
};

static void MX_GPIO_Init(void) {
    // Enable GPIOC peripheral clock
    __HAL_RCC_GPIOC_CLK_ENABLE();

    GPIO_InitTypeDef GPIO_InitStruct = {0};

    // Motor pins: PC0 (IN1), PC4 (IN2), PC5 (IN3), PC3 (IN4)
    // Status LEDs: PC6 (Red), PC7 (Blue), PC8 (Orange), PC9 (Green)
    GPIO_InitStruct.Pin = GPIO_PIN_0 | GPIO_PIN_4 | GPIO_PIN_5 | GPIO_PIN_3 |
                          GPIO_PIN_6 | GPIO_PIN_7 | GPIO_PIN_8 | GPIO_PIN_9;
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
    HAL_GPIO_Init(GPIOC, &GPIO_InitStruct);

    // Initialize all configured pins LOW
    HAL_GPIO_WritePin(GPIOC, GPIO_InitStruct.Pin, GPIO_PIN_RESET);
}

static void delay_us(uint32_t us) {
    // At 8 MHz HSI clock, 1 iteration of this volatile loop is ~1 microsecond
    volatile uint32_t count = us;
    while (count--) {
        __NOP();
    }
}

static void set_phase(uint8_t step_index) {
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_0, step_sequence[step_index][0] ? GPIO_PIN_SET : GPIO_PIN_RESET); // IN1 = PC0
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_4, step_sequence[step_index][1] ? GPIO_PIN_SET : GPIO_PIN_RESET); // IN2 = PC4
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_5, step_sequence[step_index][2] ? GPIO_PIN_SET : GPIO_PIN_RESET); // IN3 = PC5
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_3, step_sequence[step_index][3] ? GPIO_PIN_SET : GPIO_PIN_RESET); // IN4 = PC3
}

static void step_motor(int steps, int direction) {
    static int current_step = 0;

    for (int i = 0; i < steps; i++) {
        if (direction > 0) {
            current_step = (current_step + 1) % 8;
        } else {
            current_step = (current_step - 1 + 8) % 8;
        }
        set_phase(current_step);
        delay_us(STEP_DELAY_US);
    }
}

static void release_motor(void) {
    // De-energize all coils while idle so the motor does not heat up
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_0 | GPIO_PIN_4 | GPIO_PIN_5 | GPIO_PIN_3, GPIO_PIN_RESET);
}

int main(void) {
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();

    while (1) {
        // Green LED ON -> Rotate 90 degrees Clockwise
        HAL_GPIO_WritePin(GPIOC, GPIO_PIN_9, GPIO_PIN_SET);
        step_motor(STEPS_PER_90, 1);
        release_motor();
        HAL_GPIO_WritePin(GPIOC, GPIO_PIN_9, GPIO_PIN_RESET);

        HAL_Delay(1000);

        // Blue LED ON -> Rotate 90 degrees Counter-Clockwise
        HAL_GPIO_WritePin(GPIOC, GPIO_PIN_7, GPIO_PIN_SET);
        step_motor(STEPS_PER_90, -1);
        release_motor();
        HAL_GPIO_WritePin(GPIOC, GPIO_PIN_7, GPIO_PIN_RESET);

        HAL_Delay(1000);
    }
}

void SystemClock_Config(void) {
    RCC_OscInitTypeDef RCC_OscInitStruct = {0};
    RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

    RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSI;
    RCC_OscInitStruct.HSIState = RCC_HSI_ON;
    RCC_OscInitStruct.HSICalibrationValue = RCC_HSICALIBRATION_DEFAULT;
    RCC_OscInitStruct.PLL.PLLState = RCC_PLL_NONE;
    if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK) {
        Error_Handler();
    }

    RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK | RCC_CLOCKTYPE_PCLK1;
    RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_HSI;
    RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
    RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV1;

    if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_0) != HAL_OK) {
        Error_Handler();
    }
}

void Error_Handler(void) {
    __disable_irq();
    while (1) {
    }
}
